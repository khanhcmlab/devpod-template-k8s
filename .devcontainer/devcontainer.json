{
    "name": "devpod-template-k8s",
    "build": {
        "dockerfile": "./Dockerfile"
    },
    "overrideCommand": true,
    "workspaceFolder": "/workspace",
    "remoteUser": "vscode",
    "initializeCommand": "bash .devcontainer/scripts/initialize-command.sh",
    "postCreateCommand": "bash .devcontainer/scripts/post-create-command.sh",
    "customizations": {
        "vscode": {
            "settings": {
                "editor.tabSize": 2,
                "editor.insertSpaces": true,
                "editor.detectIndentation": false,
                "files.trimTrailingWhitespace": true,
                "files.insertFinalNewline": true,
                "files.autoSave": "onWindowChange",
                "files.exclude": {
                    "**/.git": true,
                    "**/.DS_Store": true,
                    "**/node_modules": true
                },
                "search.exclude": {
                    "**/node_modules": true
                },
                "terminal.integrated.defaultProfile.linux": "zsh",
                "terminal.integrated.profiles.linux": {
                    "bash": {
                        "path": "/bin/bash"
                    },
                    "zsh": {
                        "path": "/home/linuxbrew/.linuxbrew/bin/zsh"
                    }
                },
                "workbench.colorTheme": "Default Dark+",
                "workbench.iconTheme": "vscode-icons",
                "editor.formatOnSave": true,
                "[terraform]": {
                    "editor.defaultFormatter": "HashiCorp.terraform"
                },
                "[yaml]": {
                    "editor.defaultFormatter": "redhat.vscode-yaml"
                }
            },
            "extensions": [
                "ms-kubernetes-tools.vscode-kubernetes-tools",
                "HashiCorp.terraform",
                "AntonKulikov.terraform-ls",
                "ms-azuretools.vscode-azureterraform",
                "esbenp.prettier-vscode",
                "editorconfig.editorconfig",
                "redhat.vscode-yaml",
                "tflint.vscode-tflint",
                "pahud.infracost",
                "anton.vscode-tfsec",
                "eamodio.gitlens",
                "mhutchie.git-graph",
                "codezombiech.gitignore",
                "gruntfuggly.todo-tree",
                "alefragnani.bookmarks",
                "aaron-bond.better-comments",
                "coenraads.bracket-pair-colorizer",
                "oderwat.indent-rainbow",
                "streetsidesoftware.code-spell-checker",
                "yzhang.markdown-all-in-one",
                "DavidAnson.vscode-markdownlint",
                "VisualStudioExptTeam.vscodeintellicode",
                "foxundermoon.shell-format",
                "GitHub.copilot",
                "GitHub.copilot-chat",
                "GitHub.vscode-github-actions"
            ]
        }
    }
}